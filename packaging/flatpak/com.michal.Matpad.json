{
  "app-id": "com.michal.Matpad",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "branch": "stable",
  "command": "matpad",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--filesystem=xdg-cache",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "matpad",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}