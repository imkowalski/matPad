Name: matpad
Version: @VERSION@
Release: 1%{?dist}
Summary: MATLAB editor with script execution and plot previews
License: AGPL-3.0-or-later
URL: https://github.com/imkowalski/matpad
BuildArch: @ARCH@
Requires: @REQUIRES@

%description
MatPad is a GTK 4 and libadwaita desktop editor for MATLAB scripts.

%prep
%build

%install
rm -rf %{buildroot}
install -D -m 755 "@BUILD_DIR@/matpad" "%{buildroot}/usr/bin/matpad"
install -D -m 644 "@PROJECT_ROOT@/icon.png" "%{buildroot}/usr/share/icons/hicolor/256x256/apps/matpad.png"
install -D -m 644 "%{_sourcedir}/matpad.desktop" "%{buildroot}/usr/share/applications/matpad.desktop"

%files
/usr/bin/matpad
/usr/share/applications/matpad.desktop
/usr/share/icons/hicolor/256x256/apps/matpad.png