Name: matpad
Version: @VERSION@
Release: 1%{?dist}
Summary: MATLAB editor with script execution and plot previews
License: AGPL-3.0-or-later
URL: https://github.com/imkowalski/matpad
BuildArch: @ARCH@
Requires: @REQUIRES@

%description
MatPad is a GTK 4 and libadwaita desktop editor for MATLAB scripts.

%prep
%build

%install
rm -rf %{buildroot}
install -D -m 755 "@BUILD_DIR@/matpad" "%{buildroot}/usr/bin/matpad"
for icon in "@PROJECT_ROOT@"/data/icons/hicolor/*/apps/matpad.png; do \
    size="$(basename "$(dirname "$(dirname "$icon")")")"; \
    install -D -m 644 "$icon" "%{buildroot}/usr/share/icons/hicolor/${size}/apps/matpad.png"; \
done
install -D -m 644 "%{_sourcedir}/com.michal.Matpad.desktop" "%{buildroot}/usr/share/applications/com.michal.Matpad.desktop"

%files
/usr/bin/matpad
/usr/share/applications/com.michal.Matpad.desktop
/usr/share/icons/hicolor/*/apps/matpad.png