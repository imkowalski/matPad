Name: matlab-lite
Version: @VERSION@
Release: 1%{?dist}
Summary: MATLAB editor with script execution and plot previews
License: AGPL-3.0-or-later
URL: https://github.com/imkowalski/Matlab-lite
BuildArch: @ARCH@
Requires: @REQUIRES@

%description
MATLAB Lite is a GTK 4 and libadwaita desktop editor for MATLAB scripts.

%prep
%build

%install
rm -rf %{buildroot}
install -D -m 755 "@BUILD_DIR@/matlab-lite" "%{buildroot}/usr/bin/matlab-lite"
install -D -m 644 "@PROJECT_ROOT@/icon.png" "%{buildroot}/usr/share/icons/hicolor/256x256/apps/matlab-lite.png"
install -D -m 644 "%{_sourcedir}/matlab-lite.desktop" "%{buildroot}/usr/share/applications/matlab-lite.desktop"

%files
/usr/bin/matlab-lite
/usr/share/applications/matlab-lite.desktop
/usr/share/icons/hicolor/256x256/apps/matlab-lite.png